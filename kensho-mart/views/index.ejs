<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kensho Mart - Store JB & Rekber Game</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body {
      background-color: #050b14;
      color: #e2e8f0;
      font-family: system-ui, -apple-system, sans-serif;
    }
    .card-glow {
      background: #0b1526;
      border: 1px solid #13233c;
    }
    .card-glow:hover {
      border-color: #06b6d4;
      box-shadow: 0 0 15px rgba(6, 182, 212, 0.15);
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    @keyframes marquee {
      0% { transform: translateX(100%); }
      100% { transform: translateX(-100%); }
    }
    .animate-marquee {
      display: inline-block;
      white-space: nowrap;
      animation: marquee 18s linear infinite;
    }
  </style>
</head>
<body class="pb-28">

  <!-- Header / Navbar -->
  <header class="sticky top-0 z-40 bg-[#050b14]/90 backdrop-blur-md border-b border-[#13233c] px-4 py-2.5 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center font-black text-white text-lg shadow-lg shadow-cyan-500/20">
        KM
      </div>
      <div>
        <span class="font-extrabold tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400 text-base block leading-none">
          KENSHO MART
        </span>
        <span class="text-[9px] text-slate-400 flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Online Store
        </span>
      </div>
    </div>
    
    <div class="flex items-center gap-2">
      <a href="https://wa.me/<%= adminWa %>" target="_blank" class="px-2.5 py-1.5 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-[10px] font-bold flex items-center gap-1 hover:bg-emerald-500/20 transition">
        <i class="fa-brands fa-whatsapp text-xs"></i> Admin
      </a>
    </div>
  </header>

  <!-- Running Text / Live Activity -->
  <div class="bg-[#081220] border-b border-[#13233c] py-1 px-3 overflow-hidden flex items-center text-[10px] text-cyan-300/80">
    <i class="fa-solid fa-bullhorn text-amber-400 mr-2 z-10 bg-[#081220] pr-1"></i>
    <div class="overflow-hidden relative w-full">
      <div class="animate-marquee font-medium">
        ⚡ [LIVE TRANSAKSI] - User #392 berhasil membeli Akun MLBB S30 • User #102 menggunakan Jasa Rekber • Garansi Akun 100% Anti-HB!
      </div>
    </div>
  </div>

  <main class="px-3 pt-3 max-w-lg mx-auto">

    <!-- Search Bar Interaktif -->
    <div class="relative mb-4">
      <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
      <input type="text" id="search-input" onkeyup="searchProduct()" placeholder="Cari akun MLBB, FF, PUBG, skin..." 
             class="w-full pl-9 pr-4 py-2 bg-[#0b1526] border border-[#162c4a] rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:border-cyan-500 transition shadow-inner">
    </div>

    <!-- Banner Hero / Promo Slide -->
    <div class="relative overflow-hidden bg-gradient-to-r from-cyan-950 via-[#0a182e] to-slate-900 border border-cyan-500/30 rounded-2xl p-4 mb-4 shadow-xl shadow-cyan-950/40">
      <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-cyan-500/10 rounded-full blur-2xl"></div>
      <div class="flex items-center justify-between mb-2">
        <span class="bg-cyan-500/20 text-cyan-300 text-[9px] px-2.5 py-0.5 rounded-full font-bold border border-cyan-500/30">
          <i class="fa-solid fa-shield-halved mr-1 text-cyan-400"></i> Garansi Resmi Store
        </span>
        <span class="text-[9px] text-slate-400 font-semibold">V 2.0 Official</span>
      </div>
      <h2 class="text-sm font-black text-white tracking-wide mb-1">PUSAT JB & REKBER AKUN TERSEDAI</h2>
      <p class="text-[10px] text-slate-300 leading-relaxed mb-3">Transaksi cepat, mudah, aman tanpa khawatir ter-hackback.</p>
      
      <div class="flex gap-2">
        <button onclick="openRekberModal()" class="px-3 py-1.5 bg-cyan-500 text-slate-950 rounded-lg text-[10px] font-extrabold shadow-md shadow-cyan-500/20 hover:brightness-110">
          <i class="fa-solid fa-shield mr-1"></i> Pakai Rekber
        </button>
        <button onclick="scrollToKatalog()" class="px-3 py-1.5 bg-slate-800/80 text-cyan-400 border border-cyan-500/30 rounded-lg text-[10px] font-bold">
          Lihat Katalog
        </button>
      </div>
    </div>

    <!-- Quick Menu Grid -->
    <div class="grid grid-cols-4 gap-2 mb-5">
      <a href="https://wa.me/<%= adminWa %>?text=Halo%20Admin,%20saya%20mau%20titip%20jual%20akun" target="_blank" class="card-glow rounded-xl p-2.5 flex flex-col items-center text-center active:scale-95 transition">
        <i class="fa-solid fa-store text-cyan-400 text-base mb-1"></i>
        <span class="text-[10px] font-bold text-slate-200">Titip Jual</span>
      </a>
      <button onclick="openRekberModal()" class="card-glow rounded-xl p-2.5 flex flex-col items-center text-center active:scale-95 transition">
        <i class="fa-solid fa-handshake text-emerald-400 text-base mb-1"></i>
        <span class="text-[10px] font-bold text-slate-200">Rekber</span>
      </button>
      <a href="https://wa.me/<%= adminWa %>?text=Halo%20Admin,%20saya%20mau%20lihat%20testimoni" target="_blank" class="card-glow rounded-xl p-2.5 flex flex-col items-center text-center active:scale-95 transition">
        <i class="fa-solid fa-star text-amber-400 text-base mb-1"></i>
        <span class="text-[10px] font-bold text-slate-200">Testimoni</span>
      </a>
      <a href="https://wa.me/<%= adminWa %>?text=Halo%20Admin,%20bagaimana%20cara%20transaksi?" target="_blank" class="card-glow rounded-xl p-2.5 flex flex-col items-center text-center active:scale-95 transition">
        <i class="fa-solid fa-circle-question text-purple-400 text-base mb-1"></i>
        <span class="text-[10px] font-bold text-slate-200">Cara Order</span>
      </a>
    </div>

    <!-- Categories Slider Filter -->
    <div class="flex gap-4 overflow-x-auto no-scrollbar py-1 mb-4 justify-start">
      <% categories.forEach(cat => { %>
        <button onclick="filterCategory('<%= cat.id %>', this)" class="category-btn flex flex-col items-center min-w-[55px] focus:outline-none">
          <div class="cat-icon w-11 h-11 rounded-full <%= cat.active ? 'bg-cyan-500 text-slate-950 shadow-lg shadow-cyan-500/30' : 'bg-[#0b1526] text-cyan-400 border border-[#13233c]' %> flex items-center justify-center mb-1 text-sm transition">
            <i class="fa-solid <%= cat.icon %>"></i>
          </div>
          <span class="cat-text text-[10px] font-semibold tracking-wide text-center <%= cat.active ? 'text-cyan-400' : 'text-slate-400' %>"><%= cat.name %></span>
        </button>
      <% }) %>
    </div>

    <!-- Section Title -->
    <div id="katalog-section" class="flex justify-between items-center mb-3 scroll-mt-20">
      <div class="flex items-center gap-2">
        <i class="fa-solid fa-fire-flame-curved text-cyan-400 text-sm"></i>
        <h2 id="section-title" class="font-bold text-sm tracking-wide text-white">KATALOG AKUN READY</h2>
      </div>
      <span class="text-[9px] text-slate-400 font-medium">Update Setiap Hari</span>
    </div>

    <!-- Product Grid -->
    <div id="product-grid" class="grid grid-cols-3 gap-2 mb-6">
      <% products.forEach(p => { %>
        <div onclick="openProductModal(<%= JSON.stringify(p) %>)" 
             class="product-item card-glow rounded-xl p-2 flex flex-col justify-between text-center cursor-pointer active:scale-95 transition relative"
             data-category="<%= p.category %>"
             data-title="<%= p.title.toLowerCase() %>">
          
          <% if (p.isBest) { %>
            <span class="absolute top-1 right-1 bg-gradient-to-r from-amber-500 to-red-500 text-slate-950 text-[7px] font-black px-1.5 py-0.5 rounded shadow z-10 uppercase">
              HOT
            </span>
          <% } %>

          <div>
            <!-- Banner Logo Badge -->
            <div class="relative w-full aspect-square rounded-lg overflow-hidden mb-2 bg-gradient-to-br <%= p.badgeBg %> flex flex-col items-center justify-center p-2 shadow-inner border border-white/10">
              <i class="fa-solid <%= p.icon %> text-2xl text-white/90 mb-1"></i>
              <span class="text-[9px] font-black text-white tracking-widest uppercase bg-black/40 px-1.5 py-0.5 rounded backdrop-blur-sm border border-white/10">
                <%= p.badge %>
              </span>
            </div>
            <h3 class="text-[10px] font-bold leading-tight line-clamp-2 text-slate-200 mb-1">
              <%= p.title %>
            </h3>
          </div>

          <div>
            <div class="text-[11px] font-extrabold text-amber-400 mb-1">
              <%= p.price %>
            </div>
            <div class="text-[9px] text-slate-400 flex items-center justify-center gap-1 mb-1">
              <i class="fa-solid fa-fire text-amber-500 text-[9px]"></i> <%= p.sold %> Terjual
            </div>
            <button class="w-full py-1 bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 rounded-md text-[9px] font-bold hover:bg-cyan-500/20">
              Detail
            </button>
          </div>
        </div>
      <% }) %>
    </div>

  </main>

  <!-- POP-UP MODAL DETAIL PRODUK -->
  <div id="product-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-[#0b1526] border border-[#1a2e4a] w-full max-w-sm rounded-2xl p-4 relative text-left shadow-2xl">
      <button onclick="closeProductModal()" class="absolute top-3 right-3 text-slate-400 hover:text-white w-7 h-7 rounded-full bg-slate-800 flex items-center justify-center">
        <i class="fa-solid fa-xmark text-sm"></i>
      </button>

      <div id="modal-banner" class="w-full h-28 rounded-xl mb-3 border border-white/10 flex flex-col items-center justify-center p-4 shadow-inner">
        <i id="modal-icon" class="fa-solid text-3xl text-white mb-1"></i>
        <span id="modal-badge" class="text-xs font-black text-white tracking-widest bg-black/40 px-2 py-0.5 rounded border border-white/10"></span>
      </div>
      
      <h3 id="modal-title" class="font-extrabold text-sm text-white mb-2"></h3>
      
      <div class="mb-3">
        <p class="text-[10px] text-slate-400 mb-1 font-semibold">Spesifikasi Akun:</p>
        <ul id="modal-specs" class="text-[11px] text-slate-300 space-y-1 bg-[#050b14] p-2.5 rounded-lg border border-[#13233c]">
        </ul>
      </div>

      <div class="flex items-center justify-between mb-4">
        <div>
          <p class="text-[9px] text-slate-400">Harga Akun</p>
          <p id="modal-price" class="text-base font-black text-amber-400"></p>
        </div>
        <span class="text-[10px] text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-1 rounded-md font-bold">
          <i class="fa-solid fa-shield-check"></i> Garansi Ready
        </span>
      </div>

      <a id="modal-buy-btn" href="#" target="_blank" class="block w-full text-center py-2.5 bg-gradient-to-r from-cyan-500 to-blue-600 text-slate-950 font-extrabold rounded-xl text-xs shadow-lg shadow-cyan-500/20 hover:brightness-110">
        <i class="fa-brands fa-whatsapp mr-1 text-sm"></i> Beli Akun Sekarang
      </a>
    </div>
  </div>

  <!-- POP-UP MODAL JASA REKBER -->
  <div id="rekber-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-[#0b1526] border border-[#1a2e4a] w-full max-w-sm rounded-2xl p-4 relative text-left shadow-2xl">
      <button onclick="closeRekberModal()" class="absolute top-3 right-3 text-slate-400 hover:text-white w-7 h-7 rounded-full bg-slate-800 flex items-center justify-center">
        <i class="fa-solid fa-xmark text-sm"></i>
      </button>

      <div class="flex items-center gap-2 mb-3">
        <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-sm border border-emerald-500/30">
          <i class="fa-solid fa-handshake"></i>
        </div>
        <div>
          <h3 class="font-extrabold text-sm text-white">Layanan Rekber Official</h3>
          <p class="text-[9px] text-slate-400">Rekening Bersama Amanah & Terpercaya</p>
        </div>
      </div>

      <div class="space-y-2 mb-4">
        <div class="bg-[#050b14] p-2.5 rounded-xl border border-[#13233c]">
          <p class="text-[10px] font-bold text-cyan-400 mb-1"><i class="fa-solid fa-check-circle mr-1"></i> Syarat & Ketentuan Rekber:</p>
          <ul class="text-[10px] text-slate-300 space-y-1 list-disc list-inside">
            <li>Penjual & Pembeli sepakat nominal harga transaksi.</li>
            <li>Pembeli mentransfer dana ke rekening Admin Rekber.</li>
            <li>Penjual mengamankan & menyerahkan data akun.</li>
            <li>Dana diteruskan ke penjual setelah akun diverifikasi aman.</li>
          </ul>
        </div>

        <div class="bg-[#050b14] p-2.5 rounded-xl border border-[#13233c] flex justify-between items-center">
          <div>
            <p class="text-[10px] font-bold text-amber-400">Biaya Admin Rekber</p>
            <p class="text-[9px] text-slate-400">Mulai Rp 5.000 / transaksi</p>
          </div>
          <span class="text-[10px] font-extrabold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-1 rounded-md">Low Fee</span>
        </div>
      </div>

      <a href="https://wa.me/<%= adminWa %>?text=Halo%20Admin,%20saya%20ingin%20menggunakan%20Jasa%20Rekber" target="_blank" class="block w-full text-center py-2.5 bg-gradient-to-r from-emerald-500 to-teal-600 text-slate-950 font-extrabold rounded-xl text-xs shadow-lg shadow-emerald-500/20">
        <i class="fa-brands fa-whatsapp mr-1 text-sm"></i> Mulai Transaksi Rekber
      </a>
    </div>
  </div>

  <!-- POP-UP MODAL UPDATE TERBARU -->
  <div id="update-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-[#0b1526] border border-[#1a2e4a] w-full max-w-sm rounded-2xl p-4 relative text-left shadow-2xl">
      <button onclick="closeUpdateModal()" class="absolute top-3 right-3 text-slate-400 hover:text-white w-7 h-7 rounded-full bg-slate-800 flex items-center justify-center">
        <i class="fa-solid fa-xmark text-sm"></i>
      </button>

      <div class="flex items-center gap-2 mb-3">
        <div class="w-8 h-8 rounded-lg bg-cyan-500/20 text-cyan-400 flex items-center justify-center text-sm border border-cyan-500/30">
          <i class="fa-solid fa-rotate"></i>
        </div>
        <div>
          <h3 class="font-extrabold text-sm text-white">Update & Info Terbaru</h3>
          <p class="text-[9px] text-slate-400">Informasi Stok & Fitur Toko</p>
        </div>
      </div>

      <div class="space-y-2 mb-4">
        <% updates.forEach(u => { %>
          <div class="bg-[#050b14] p-2.5 rounded-xl border border-[#13233c]">
            <div class="flex justify-between items-center mb-1">
              <span class="text-[9px] font-bold text-cyan-400"><i class="fa-solid fa-bell mr-1"></i> Pemberitahuan</span>
              <span class="text-[8px] text-slate-400"><%= u.time %></span>
            </div>
            <p class="text-[10px] text-slate-200"><%= u.title %></p>
          </div>
        <% }) %>
      </div>

      <button onclick="closeUpdateModal()" class="w-full py-2 bg-slate-800 text-slate-200 text-xs font-bold rounded-xl border border-slate-700">
        Tutup
      </button>
    </div>
  </div>

  <!-- Bottom Floating Navbar -->
  <nav class="fixed bottom-2 left-1/2 -translate-x-1/2 w-[95%] max-w-md bg-[#081220]/95 backdrop-blur-xl border border-[#162c4a] rounded-2xl p-1.5 z-40 shadow-2xl">
    <div class="grid grid-cols-5 items-center text-center">
      <a href="#" class="flex flex-col items-center py-1 rounded-xl bg-cyan-500/10 text-cyan-400 border border-cyan-500/30">
        <i class="fa-solid fa-house text-xs"></i>
        <span class="text-[8px] font-bold mt-0.5">Home</span>
      </a>

      <button onclick="scrollToKatalog()" class="flex flex-col items-center py-1 text-slate-400 hover:text-cyan-400">
        <i class="fa-solid fa-layer-group text-xs"></i>
        <span class="text-[8px] font-medium mt-0.5">Katalog</span>
      </button>

      <button onclick="openRekberModal()" class="flex flex-col items-center py-1 text-emerald-400 hover:text-emerald-300">
        <i class="fa-solid fa-handshake text-xs"></i>
        <span class="text-[8px] font-bold mt-0.5">Rekber</span>
      </button>

      <button onclick="openUpdateModal()" class="flex flex-col items-center py-1 text-slate-400 hover:text-cyan-400 relative">
        <span class="absolute top-0 right-3 bg-cyan-500 text-slate-950 text-[7px] font-black w-3 h-3 rounded-full flex items-center justify-center"><%= updates.length %></span>
        <i class="fa-solid fa-rotate text-xs"></i>
        <span class="text-[8px] font-medium mt-0.5">Update</span>
      </button>

      <button onclick="alert('Fitur Login member akan segera hadir!')" class="flex flex-col items-center py-1 text-slate-400 hover:text-cyan-400">
        <i class="fa-solid fa-right-to-bracket text-xs"></i>
        <span class="text-[8px] font-medium mt-0.5">Login</span>
      </button>
    </div>
  </nav>

  <!-- JavaScript Interaktif -->
  <script>
    const adminWa = "<%= adminWa %>";

    function filterCategory(catId, btnElement) {
      document.querySelectorAll('.category-btn').forEach(btn => {
        const icon = btn.querySelector('.cat-icon');
        const text = btn.querySelector('.cat-text');
        icon.className = 'cat-icon w-11 h-11 rounded-full bg-[#0b1526] text-cyan-400 border border-[#13233c] flex items-center justify-center mb-1 text-sm transition';
        text.className = 'cat-text text-[10px] font-semibold tracking-wide text-center text-slate-400';
      });

      const activeIcon = btnElement.querySelector('.cat-icon');
      const activeText = btnElement.querySelector('.cat-text');
      activeIcon.className = 'cat-icon w-11 h-11 rounded-full bg-cyan-500 text-slate-950 shadow-lg shadow-cyan-500/30 flex items-center justify-center mb-1 text-sm transition';
      activeText.className = 'cat-text text-[10px] font-semibold tracking-wide text-center text-cyan-400';

      const items = document.querySelectorAll('.product-item');
      items.forEach(item => {
        if (catId === 'all' || item.getAttribute('data-category') === catId) {
          item.style.display = 'flex';
        } else {
          item.style.display = 'none';
        }
      });
    }

    function searchProduct() {
      const input = document.getElementById('search-input').value.toLowerCase();
      const items = document.querySelectorAll('.product-item');
      
      items.forEach(item => {
        const title = item.getAttribute('data-title');
        if (title.includes(input)) {
          item.style.display = 'flex';
        } else {
          item.style.display = 'none';
        }
      });
    }

    function scrollToKatalog() {
      document.getElementById('katalog-section').scrollIntoView({ behavior: 'smooth' });
    }

    function openProductModal(product) {
      const banner = document.getElementById('modal-banner');
      banner.className = `w-full h-28 rounded-xl mb-3 border border-white/10 flex flex-col items-center justify-center p-4 shadow-inner bg-gradient-to-br ${product.badgeBg}`;
      
      document.getElementById('modal-icon').className = `fa-solid ${product.icon} text-3xl text-white mb-1`;
      document.getElementById('modal-badge').innerText = product.badge;
      document.getElementById('modal-title').innerText = product.title;
      document.getElementById('modal-price').innerText = product.price;

      const specsList = document.getElementById('modal-specs');
      specsList.innerHTML = '';
      if(product.specs && product.specs.length > 0) {
        product.specs.forEach(spec => {
          specsList.innerHTML += `<li class="flex items-center gap-1.5"><i class="fa-solid fa-check text-cyan-400 text-[10px]"></i> ${spec}</li>`;
        });
      } else {
        specsList.innerHTML = `<li><i class="fa-solid fa-check text-cyan-400"></i> Garansi Akun Sepaket</li>`;
      }

      const waText = encodeURIComponent(`Halo Admin Kensho Mart, saya ingin membeli ${product.title} seharga ${product.price}`);
      document.getElementById('modal-buy-btn').href = `https://wa.me/${adminWa}?text=${waText}`;

      document.getElementById('product-modal').classList.remove('hidden');
    }

    function closeProductModal() {
      document.getElementById('product-modal').classList.add('hidden');
    }

    function openRekberModal() {
      document.getElementById('rekber-modal').classList.remove('hidden');
    }

    function closeRekberModal() {
      document.getElementById('rekber-modal').classList.add('hidden');
    }

    function openUpdateModal() {
      document.getElementById('update-modal').classList.remove('hidden');
    }

    function closeUpdateModal() {
      document.getElementById('update-modal').classList.add('hidden');
    }
  </script>

</body>
</html>
